# Preferred live autonomy provider: Claude Code headless CLI.
# Auth is handled by Claude Code itself (ANTHROPIC_API_KEY / Foundry / Bedrock / Vertex).
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT_SECONDS=120
CLAUDE_CODE_MCP_CONFIG=
# Empty = proposal-only mode (Elenchos executes/gates all actions).
CLAUDE_CODE_ALLOWED_TOOLS=

# Legacy openai-compatible provider (superseded by Claude Code; kept for back-compat).
MODEL_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://your-endpoint.example.com/v1
OPENAI_API_KEY=replace-me
MODEL_NAME=replace-me

SIFTGUARD_CASES_DIR=./cases
SIFTGUARD_RUNS_DIR=./runs
SIFTGUARD_LOG_LEVEL=INFO
